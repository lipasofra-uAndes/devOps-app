{
    "info": {
        "name": "Global Email Blacklist API",
        "description": "Auth, create, duplicate, lookup and validation scenarios for the blacklist microservice.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{access_token}}",
                "type": "string"
            }
        ]
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:5000"
        }
    ],
    "item": [
        {
            "name": "Obtener JWT",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"username\": \"api-client\",\n  \"password\": \"local-password\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "{{base_url}}/auth/token"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('JWT emitido', function () {",
                            "  pm.response.to.have.status(200);",
                            "  pm.environment.set('access_token', pm.response.json().access_token);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Agregar email",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"cliente@example.com\",\n  \"app_uuid\": \"123e4567-e89b-12d3-a456-426614174000\",\n  \"blocked_reason\": \"Contracargo confirmado\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "{{base_url}}/blacklists"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Email agregado', function () { pm.response.to.have.status(201); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Agregar email duplicado (409)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"CLIENTE@example.com\",\n  \"app_uuid\": \"123e4567-e89b-12d3-a456-426614174000\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "{{base_url}}/blacklists"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Duplicado responde 409', function () { pm.response.to.have.status(409); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Consultar email bloqueado",
            "request": {
                "method": "GET",
                "url": "{{base_url}}/blacklists/cliente@example.com"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Email aparece bloqueado', function () {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(pm.response.json().blacklisted).to.eql(true);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Consultar email no registrado",
            "request": {
                "method": "GET",
                "url": "{{base_url}}/blacklists/no-registrado@example.com"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Email no aparece bloqueado', function () {",
                            "  pm.response.to.have.status(200);",
                            "  pm.expect(pm.response.json().blacklisted).to.eql(false);",
                            "});"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Email inválido (400)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"no-es-un-correo\",\n  \"app_uuid\": \"123e4567-e89b-12d3-a456-426614174000\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "{{base_url}}/blacklists"
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Formato inválido responde 400', function () { pm.response.to.have.status(400); });"
                        ]
                    }
                }
            ]
        }
    ]
}