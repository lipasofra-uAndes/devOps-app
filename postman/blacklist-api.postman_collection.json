          }
        ],
        "url": "{{base_url}}/blacklists",
        "description": "app_uuid debe tener formato UUID; un valor inválido retorna 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"otro-{{test_email}}\",\n  \"app_uuid\": \"no-es-uuid\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
