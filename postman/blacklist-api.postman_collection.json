{
  "info": {
    "name": "Global Email Blacklist API - Entrega 1",
    "description": "Escenarios reproducibles para la API de lista negra. Ejecutar la colección completa en orden. base_url apunta por defecto al entorno Elastic Beanstalk (us-east-1); usar el environment local para pruebas en 127.0.0.1:5000. Configurar auth_username y auth_password en un environment. No exportar credenciales reales. El email se genera por ejecución.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://devops-blacklist-api-dev.eba-2zph7mid.us-east-1.elasticbeanstalk.com"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "test_email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Obtener JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/token",
        "description": "Genera JWT Bearer. 200: access_token; 401: credenciales inválidas.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{auth_username}}\",\n  \"password\": \"{{auth_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('test_email', 'probe-' + Date.now() + '-' + Math.floor(Math.random() * 1000000) + '@example.com');",
              "pm.collectionVariables.unset('access_token');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('JWT emitido', function () { pm.response.to.have.status(200); const data = pm.response.json(); pm.expect(data.access_token).to.be.a('string').and.not.empty; pm.collectionVariables.set('access_token', data.access_token); });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 JWT",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"api-client\",\n  \"password\": \"<password>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"access_token\": \"<JWT>\"\n}"
        }
      ]
    },
    {
      "name": "02 Health y versión",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health",
        "description": "Comprueba la base de datos (200 o 503) y la versión empaquetada en X-App-Version.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Servicio saludable', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });",
              "pm.test('Versión disponible', function () { pm.expect(pm.response.headers.get('X-App-Version')).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 saludable",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"status\": \"ok\"\n}"
        }
      ]
    },
    {
      "name": "03 Agregar email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/blacklists",
        "description": "Registra email, UUID obligatorio y motivo opcional de máximo 255 caracteres. Requiere JWT. 201: creado; 400: inválido; 409: duplicado.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"app_uuid\": \"123e4567-e89b-12d3-a456-426614174000\",\n  \"blocked_reason\": \"Prueba Postman Entrega 1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Alta 201', function () { pm.response.to.have.status(201); pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('test_email')); });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "201 creado",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/blacklists",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@example.com\",\n  \"app_uuid\": \"123e4567-e89b-12d3-a456-426614174000\",\n  \"blocked_reason\": \"Prueba Postman Entrega 1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "status": "Created",
          "code": 201,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"message\": \"Email added to the blacklist.\",\n  \"email\": \"cliente@example.com\"\n}"
        }
      ]
    },
    {
      "name": "04 Duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/blacklists",
        "description": "El mismo email registrado en 03 debe retornar 409.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"app_uuid\": \"123e4567-e89b-12d3-a456-426614174000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicado 409', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "409 duplicado",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/blacklists",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@example.com\",\n  \"app_uuid\": \"123e4567-e89b-12d3-a456-426614174000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "status": "Conflict",
          "code": 409,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"message\": \"This email already belongs to the blacklist.\"\n}"
        }
      ]
    },
    {
      "name": "05 Consultar email bloqueado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/blacklists/{{test_email}}",
        "description": "Devuelve blacklisted true y el motivo cuando el email existe."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Bloqueado y motivo', function () { pm.response.to.have.status(200); const data = pm.response.json(); pm.expect(data.blacklisted).to.eql(true); pm.expect(data.blocked_reason).to.eql('Prueba Postman Entrega 1'); });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 bloqueado",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/blacklists/cliente@example.com"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"email\": \"cliente@example.com\",\n  \"blacklisted\": true,\n  \"blocked_reason\": \"Prueba Postman Entrega 1\"\n}"
        }
      ]
    },
    {
      "name": "06 Consultar email no registrado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/blacklists/no-registrado-{{test_email}}",
        "description": "Devuelve blacklisted false y blocked_reason null cuando no existe."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('No bloqueado', function () { pm.response.to.have.status(200); const data = pm.response.json(); pm.expect(data.blacklisted).to.eql(false); pm.expect(data.blocked_reason).to.eql(null); });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200 no bloqueado",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/blacklists/otro@example.com"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"email\": \"otro@example.com\",\n  \"blacklisted\": false,\n  \"blocked_reason\": null\n}"
        }
      ]
    },
    {
      "name": "07 Email inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/blacklists",
        "description": "Un email mal formado debe retornar 400.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"no-es-correo\",\n  \"app_uuid\": \"123e4567-e89b-12d3-a456-426614174000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Email inválido 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "400 email inválido",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/blacklists",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-es-correo\",\n  \"app_uuid\": \"123e4567-e89b-12d3-a456-426614174000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "status": "Bad Request",
          "code": 400,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"message\": \"Invalid request.\",\n  \"errors\": {\n    \"email\": [\n      \"Not a valid email address.\"\n    ]\n  }\n}"
        }
      ]
    },
