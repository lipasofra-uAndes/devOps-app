              "pm.test('UUID inválido 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "400 UUID inválido",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/blacklists",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"otro@example.com\",\n  \"app_uuid\": \"no-es-uuid\"\n}",
