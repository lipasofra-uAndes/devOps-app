          "body": "{\n  \"message\": \"Invalid request.\",\n  \"errors\": {\n    \"blocked_reason\": [\n      \"Longer than maximum length 255.\"\n    ]\n  }\n}"
        }
      ]
    },
    {
      "name": "10 Sin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/blacklists/{{test_email}}",
        "description": "Sin Bearer token debe retornar 401.",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sin token 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "401 sin token",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/blacklists/cliente@example.com"
          },
          "status": "Unauthorized",
          "code": 401,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"msg\": \"Missing Authorization Header\"\n}"
        }
      ]
